#!/usr/bin/env bash
# Verifica la configuración contra la golden; restaura y re-bloquea si cambió.
# Uso: systemctl start appblocker-integrity.service  (o a mano)
set -euo pipefail

BASE=/etc/appblocker
GOLDEN="$BASE/golden"

audit() { logger -t appblocker "$*" 2>/dev/null || true; }

for live in "$BASE/config.toml" "$BASE"/policy.d/*.toml; do
  [ -f "$live" ] || continue
  rel="${live#"$BASE"/}"
  golden="$GOLDEN/$rel"
  [ -f "$golden" ] || continue

  if ! cmp -s "$golden" "$live"; then
    chattr -i "$live" 2>/dev/null || true
    cp -a "$golden" "$live"
    chattr +i "$live" 2>/dev/null || true
    audit "integrity-restore file=$live"
    echo "  restaurado: $live"
    continue
  fi

  if ! lsattr -d "$live" 2>/dev/null | cut -d' ' -f1 | grep -q i; then
    chattr +i "$live" 2>/dev/null || true
    audit "integrity-relock file=$live"
    echo "  re-bloqueado: $live"
  fi
done

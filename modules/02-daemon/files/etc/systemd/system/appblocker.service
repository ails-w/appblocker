[Unit]
Description=AppBlocker focus daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/appblocker/daemon.py
Restart=always
RestartSec=2
RuntimeDirectory=appblocker
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
